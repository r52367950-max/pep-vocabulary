{
  "name": "pep-vocab-studio",
  "version": "2.19.3",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite preview",
    "data:manifest": "node scripts/build-source-manifest.mjs",
    "data:build": "node scripts/build-lexicon.mjs",
    "data:audit": "node scripts/audit-data.mjs",
    "test:unit": "node --import ./tests/register.mjs --test --test-concurrency=2 tests/*.test.mjs",
    "test": "npm run data:audit && npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:runtime",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test:runtime": "node scripts/smoke-worker.mjs",
    "benchmark": "node scripts/benchmark-core.mjs",
    "benchmark:backend": "node --import ./tests/register.mjs scripts/benchmark-backend.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --include=dev --audit-level=high"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.468.0",
    "next": "16.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "ts-fsrs": "5.2.3",
    "fflate": "0.7.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@cloudflare/workers-types": "5.20260914.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "6.2.5",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.6",
    "wrangler": "4.131.2"
  },
  "type": "module",
  "displayName": "词迹 · 英语词汇学习",
  "overrides": {
    "image-size": "2.0.4",
    "esbuild": "0.28.2",
    "undici": "7.30.2",
    "fast-uri": "3.1.9",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "satori": "0.33.5",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "zod": "4.6.7",
    "fflate": "0.7.5"
  }
}
