{
  "name": "pep-vocab-studio",
  "version": "2.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "data:manifest": "node scripts/build-source-manifest.mjs",
    "data:build": "node scripts/build-lexicon.mjs",
    "data:audit": "node scripts/audit-data.mjs",
    "test:unit": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "test": "npm run data:audit && npm run typecheck && npm run test:unit && npm run build && npm run test:runtime",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test:runtime": "node scripts/smoke-worker.mjs",
    "benchmark": "node scripts/benchmark-core.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-fsrs": "^5.2.3",
    "fflate": "0.7.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "fake-indexeddb": "^6.2.5",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  },
  "type": "module",
  "displayName": "\u8bcd\u8ff9 \u00b7 \u82f1\u8bed\u8bcd\u6c47\u5b66\u4e60",
  "overrides": {
    "image-size": "2.0.4",
    "esbuild": "0.28.2"
  }
}
