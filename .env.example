# Server runtime only. Never prefix these names with NEXT_PUBLIC_ or VITE_.
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=

# Required before the in-app server configuration form can store a key in D1.
# Use a randomly generated value of at least 32 characters and store it as a Secret.
AI_CONFIG_ENCRYPTION_KEY=
AI_CONFIG_ADMIN_EMAILS=

# Optional bounded operational controls.
AI_REQUEST_TIMEOUT_MS=20000
AI_RATE_LIMIT_PER_MINUTE=12
AI_RATE_LIMIT_PER_DAY=200

# Local development only; production remains HTTPS-only.
AI_ALLOW_INSECURE_LOCAL_BASE_URL=false
