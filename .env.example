# Generate a unique 32-byte base64 value for local development only.
# Production uses a Sites Secret and never commits its value.
AI_CONFIG_ENCRYPTION_KEY=
# Required: exact comma-separated gateway host names, without scheme/path/port.
# Only use localhost here for an explicitly configured local test gateway.
# Missing/invalid configuration disables private APIs; it never bypasses identity.
IDENTITY_TRUSTED_HOSTS=
# Optional key rotation (see AI_ASSISTANT_DEPLOYMENT.md). When AI_CONFIG_ENCRYPTION_KEYS is
# set, the active kid must exist in it and the legacy key above is treated as k1.
# AI_CONFIG_ENCRYPTION_KEYS={"k1":"<base64-32-bytes>","k2":"<base64-32-bytes>"}
# AI_CONFIG_ENCRYPTION_KEY_ACTIVE=k2

# Optional additional trusted AI provider origins, comma-separated, HTTPS only.
# Defaults always include https://api.deepseek.com and https://api.openai.com.
# Exact origins only: no paths, wildcards, credentials, queries or fragments.
# Operators must control/trust each added origin and its DNS/egress destination.
AI_ALLOWED_PROVIDER_ORIGINS=
